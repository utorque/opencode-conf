{
  // Single source of truth for opencode config.
  // Consolidated from opencode.json + opencode.jsonc (2026-06-29).
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "cc-safety-net"
  ],
  // Always-on rules. AGENTS.md first as the index the reader hits first.
  "instructions": [
    "AGENTS.md",
    "instructions/caveman.md",
    "instructions/user-preferences.md",
    "instructions/context-hygiene.md",
    ".opencode/context/CONTEXT.md"
  ],
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "provider": {
    // neuralwatt models not yet on the global models.dev repertoire.
    "neuralwatt": {
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "attachment": false,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "cost": {
            "input": 0,
            "output": 0
          },
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        }
      }
    }
  },
  "agent": {
    "plan": {
      "disable": true
    }
  }
}
